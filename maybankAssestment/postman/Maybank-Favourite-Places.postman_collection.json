{
  "info": {
    "name": "Maybank - Favourite Places API",
    "description": "Spring Boot assessment API. Run 'Create favourite' first: it stores the new id in {{favouriteId}} for the other requests.\n\nChange {{baseUrl}} in the collection Variables tab if the app runs on another port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "favouriteId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Create favourite (INSERT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('favouriteId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/favourites",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"googlePlaceId\": \"ChIJ5-rvAcdJzDERfSgcL1uO2fQ\",\n  \"name\": \"Petronas Twin Towers\",\n  \"address\": \"Kuala Lumpur City Centre, 50088 Kuala Lumpur\",\n  \"latitude\": 3.1578,\n  \"longitude\": 101.7117,\n  \"note\": \"Must visit at night\"\n}"
        }
      }
    },
    {
      "name": "2. Update favourite (UPDATE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/favourites/{{favouriteId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"googlePlaceId\": \"ChIJ5-rvAcdJzDERfSgcL1uO2fQ\",\n  \"name\": \"KLCC\",\n  \"address\": \"Kuala Lumpur City Centre, 50088 Kuala Lumpur\",\n  \"latitude\": 3.1578,\n  \"longitude\": 101.7117,\n  \"note\": \"Updated note\"\n}"
        }
      }
    },
    {
      "name": "3. Get favourite by id (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/favourites/{{favouriteId}}"
      }
    },
    {
      "name": "3b. Find favourite by Google place id (GET)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/favourites/by-place?googlePlaceId=ChIJ5-rvAcdJzDERfSgcL1uO2fQ",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "favourites", "by-place"],
          "query": [
            { "key": "googlePlaceId", "value": "ChIJ5-rvAcdJzDERfSgcL1uO2fQ", "description": "404 if the place is not a favourite" }
          ]
        }
      }
    },
    {
      "name": "4. List favourites - paginated, 10 per page (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('page size is 10', () => pm.expect(pm.response.json().size).to.eql(10));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/favourites?page=0&sort=createdAt,desc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "favourites"],
          "query": [
            { "key": "page", "value": "0", "description": "zero-based page number" },
            { "key": "sort", "value": "createdAt,desc", "description": "optional, e.g. name,asc" }
          ]
        }
      }
    },
    {
      "name": "5. Get weather for favourite (nested 3rd-party call)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('has weather', () => pm.expect(pm.response.json().weather).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/favourites/{{favouriteId}}/weather",
        "description": "Postman -> this API -> https://api.open-meteo.com/v1/forecast -> combined response"
      }
    },
    {
      "name": "6. Delete favourite",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/favourites/{{favouriteId}}"
      }
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Validation error (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/favourites",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"latitude\": 200\n}" }
          }
        },
        {
          "name": "Not found (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/favourites/999999"
          }
        }
      ]
    }
  ]
}
